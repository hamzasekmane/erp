{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node -r @swc-node/register src/main.ts",
    "db:generate": "drizzle-kit generate --dialect postgresql --schema src/db/schema.ts --out drizzle",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "openapi": "tsx src/openapi/generate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@electric-sql/pglite": "^0.3.14",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.44.7",
    "helmet": "^8.3.0",
    "jose": "^6.1.2",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.7",
    "supertest": "^7.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.4"
  }
}
