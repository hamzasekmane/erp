# Copier en `.env.production` et remplir. Ne jamais committer ce fichier.

# --- Base de données (docker-compose) ---
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-password

# --- API ---
NODE_ENV=production
PORT=4000
APP_URL=https://app.example.com
# URL publique utilisée pour les retours de paiement (success_url / failure_url)
APP_PUBLIC_URL=https://app.example.com
# Origines autorisées (séparées par des virgules, pas de joker en production)
CORS_ORIGINS=https://app.example.com

# JWT_SECRET: openssl rand -base64 48
JWT_SECRET=replace-with-48-random-bytes
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Base PostgreSQL managée (optionnel si docker-compose fournit DATABASE_URL)
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Chiffrement des secrets (clés de passerelle en base) ---
# openssl rand -hex 32 — obligatoire dès qu'une clé de passerelle est stockée
SECRETS_ENCRYPTION_KEY=replace-with-64-hex-characters

# --- Chargily Pay (CIB / EDAHABIA, DZ) ---
# La clé ci-dessous sert de solution de repli plateforme; une clé par tenant
# peut être enregistrée depuis Paramètres → Paiement (chiffrée en base).
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=test_sk_replace_me
# Optionnel: force l'URL de webhook sur chaque checkout
# CHARGILY_WEBHOOK_URL=https://app.example.com/api/payments/chargily/webhook

# Migrations: laisser true pour un déploiement simple, false + `npm run db:migrate` en pipeline
RUN_MIGRATIONS_ON_BOOT=true

# Limites
RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_MB=10
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Documentation API (désactivée par défaut en production)
ENABLE_API_DOCS=false

# E-mails (SMTP réel obligatoire pour l'envoi)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="ERP <no-reply@example.com>"
MAIL_OUTBOX_DIR=/app/.data/mail
OUTBOX_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_DISABLED=false

# Maintenance planifiée
MAINTENANCE_INTERVAL_MS=21600000
MAINTENANCE_DISABLED=false
# openssl rand -hex 32 — utilisé par le cron externe
MAINTENANCE_TOKEN=replace-with-random-token

# Seed (uniquement au premier déploiement)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
SEED_ALLOW_PRODUCTION=true
SEED_DEMO=false
