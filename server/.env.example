# API
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database: leave DATABASE_URL empty to use the embedded PGlite database (dev only)
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Auth
JWT_SECRET=change-me-in-production-please-use-32-chars-min
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# Seed (only used by npm run db:seed)
SEED_ADMIN_EMAIL=admin@demo.dz
SEED_ADMIN_PASSWORD=Admin12345!
SEED_TENANT_NAME=Demo ERP
SEED_TENANT_SUBDOMAIN=demo

# Mail (without SMTP_URL, messages are written to MAIL_OUTBOX_DIR)
SMTP_URL=
MAIL_FROM=ERP <no-reply@erp.local>
MAIL_OUTBOX_DIR=.data/mail

# Outbox worker (e-mails) and scheduled maintenance
OUTBOX_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_DISABLED=false
MAINTENANCE_INTERVAL_MS=21600000
MAINTENANCE_DISABLED=false
MAINTENANCE_TOKEN=

# Uploads (local disk; mount a volume in production)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
