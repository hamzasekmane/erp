# ---------------------------------------------------------------------------
# docker compose environment (copy to .env)
# ---------------------------------------------------------------------------
#   cp .env.example .env
#   cp server/.env.production.example server/.env.production   # optional
#   docker compose up --build
#
# Only POSTGRES_PASSWORD is strictly required: compose refuses to start
# without it, which is deliberate (no default credential in production).
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_DB=erp
POSTGRES_USER=erp
# REQUIRED. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Web (Next.js) ----------------------------------------------------------
# Base URL the BROWSER uses. "/api" keeps everything same-origin behind the
# Next.js proxy, which is the recommended deployment.
NEXT_PUBLIC_API_URL=/api
# Where the Next.js server forwards /api/*. Inside compose this is the api
# service; set it to "" to disable the proxy and call the API directly.
API_PROXY_TARGET=http://api:4000
